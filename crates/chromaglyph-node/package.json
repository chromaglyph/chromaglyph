{
  "name": "@chromaglyph/node",
  "version": "0.2.1",
  "description": "napi-rs bindings for chromaglyph: compile syntax highlighting into a color font, in-process",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chromaglyph/chromaglyph.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "css.mjs",
    "*.node"
  ],
  "napi": {
    "binaryName": "chromaglyph",
    "npmDir": "../../npm",
    "triples": {}
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">= 18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css": "./css.mjs"
  },
  "optionalDependencies": {
    "@chromaglyph/node-darwin-arm64": "0.2.1",
    "@chromaglyph/node-darwin-x64": "0.2.1",
    "@chromaglyph/node-linux-x64-gnu": "0.2.1",
    "@chromaglyph/node-linux-x64-musl": "0.2.1",
    "@chromaglyph/node-linux-arm64-gnu": "0.2.1",
    "@chromaglyph/node-linux-arm64-musl": "0.2.1",
    "@chromaglyph/node-win32-x64-msvc": "0.2.1"
  }
}
