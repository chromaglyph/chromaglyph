{
  "name": "@chromaglyph/remark",
  "version": "0.4.1",
  "description": "remark plugin: highlight code blocks by compiling them into a chromaglyph color font",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@chromaglyph/node": "workspace:*",
    "unist-util-visit": "^5"
  },
  "devDependencies": {
    "@types/mdast": "^4",
    "rehype-stringify": "^10",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unified": "^11",
    "vfile": "^6",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chromaglyph/chromaglyph.git"
  }
}
